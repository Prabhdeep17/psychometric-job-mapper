# Copy this file to .env and fill in your key.
# Do not commit .env. The app never prints the key.

# Free key: https://console.groq.com
GROQ_API_KEY=

# First ID is tried first. Later IDs are used only when the router is allowed
# to switch. Use IDs that GET /models returns for your account.
# Production chat models documented by Groq (check the catalogue; IDs change):
#   llama-3.3-70b-versatile
#   llama-3.1-8b-instant
#   openai/gpt-oss-120b
#   openai/gpt-oss-20b
GROQ_MODEL_PREFERENCE=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b

# Extra IDs appended after the preference list. Duplicates are ignored.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b

# How long to cache GET /models, in seconds.
GROQ_MODEL_CATALOG_TTL_SECONDS=3600

# Attempts on the same model for timeouts, HTTP 429 (model-specific), and HTTP 5xx.
GROQ_MAX_RETRIES=2

# How many additional models may be tried after the first one.
GROQ_MAX_FALLBACKS=3

# Longest pause this app will take for Retry-After, in seconds.
# A longer server delay is reported; the app does not block for minutes.
GROQ_MAX_RETRY_WAIT_SECONDS=8

# HTTP timeout for each Groq request.
GROQ_TIMEOUT_SECONDS=45

# Model IDs containing these words are not used for text explanations
# (audio, speech, and safety-classifier models).
GROQ_EXCLUDED_MODEL_PATTERNS=whisper,orpheus,tts,prompt-guard,playai,distil-whisper,llama-guard,safeguard

# Skip catalogue models whose context window is below this size, when the
# catalogue includes a context_window field.
GROQ_MIN_CONTEXT_TOKENS=4096
