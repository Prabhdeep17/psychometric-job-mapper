# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key from https://console.groq.com — the key previously used here was
# exposed and must be revoked and replaced (see README).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT=30
# OPENAI_API_KEY=
